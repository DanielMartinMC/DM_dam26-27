<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_equipo1"
        android:layout_width="130dp"
        android:layout_height="40dp"
        android:layout_marginStart="148dp"
        android:layout_marginTop="108dp"
        android:text="@string/equipo_1"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_equipo2"
        android:layout_width="130dp"
        android:layout_height="40dp"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="188dp"
        android:text="@string/equipo_2"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textX"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintBottom_toBottomOf="@+id/text34"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text34" />

    <TextView
        android:id="@+id/text10"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/ds_digital"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/diez_hora"
        android:textColor="@color/red"
        android:textSize="64sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text34"
        android:layout_width="137dp"
        android:layout_height="104dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ds_digital"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/treinta_cuatro"
        android:textColor="@color/green"
        android:textSize="84sp"
        app:layout_constraintEnd_toStartOf="@+id/textX"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/text_equipo1"
        app:layout_constraintTop_toBottomOf="@+id/text_equipo1" />

    <TextView
        android:id="@+id/text18"
        android:layout_width="137dp"
        android:layout_height="104dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ds_digital"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/dieciocho"
        android:textColor="@color/green"
        android:textSize="84sp"
        app:layout_constraintEnd_toEndOf="@+id/text_equipo2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/textX"
        app:layout_constraintTop_toBottomOf="@+id/text_equipo2" />

    <TextView
        android:id="@+id/text1º"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/primero"
        android:textColor="@color/white"
        android:textSize="36sp"
        app:layout_constraintStart_toEndOf="@+id/text10"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ds_digital"
        android:text="@string/cero"
        android:textColor="@color/yellow"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="@+id/button_8"
        app:layout_constraintEnd_toStartOf="@+id/textx"
        app:layout_constraintTop_toTopOf="@+id/button_8" />

    <TextView
        android:id="@+id/text02"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ds_digital"
        android:text="@string/cero"
        android:textColor="@color/yellow"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="@+id/button_7"
        app:layout_constraintStart_toEndOf="@+id/textx"
        app:layout_constraintTop_toTopOf="@+id/button_7" />

    <TextView
        android:id="@+id/textx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/x"
        android:textColor="@color/white"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/button_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_8" />

    <!-- Botones de incremento Equipo 1 (Lado Izquierdo) -->
    <Button
        android:id="@+id/play_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/play_circle"
        android:importantForAccessibility="no"
        app:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/boton_uno"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas_uno"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        tools:layout_editor_absoluteX="24dp"
        tools:layout_editor_absoluteY="115dp" />

    <Button
        android:id="@+id/button_2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas_dos"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        tools:layout_editor_absoluteX="24dp"
        tools:layout_editor_absoluteY="193dp" />

    <Button
        android:id="@+id/button_3"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas_tres"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        tools:layout_editor_absoluteX="24dp"
        tools:layout_editor_absoluteY="271dp" />

    <!-- Botones de incremento Equipo 2 (Lado Derecho) -->
    <Button
        android:id="@+id/button_4"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas_uno"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/button_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text1º" />

    <Button
        android:id="@+id/button_5"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas_dos"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/button_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_4" />

    <Button
        android:id="@+id/button_6"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas_tres"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/button10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_5" />

    <!-- Botones de Faltas Inferiores -->
    <Button
        android:id="@+id/button_8"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text0" />

    <Button
        android:id="@+id/button_7"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/circle_button"
        android:gravity="center"
        android:padding="0dp"
        android:text="@string/mas"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:backgroundTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text02" />

    <!-- Botones Inferiores Principales (Editar y Compartir) -->

    <Button
        android:id="@+id/button9"
        android:layout_width="100dp"
        android:layout_height="45dp"
        android:background="@drawable/rectangle"
        android:text="@string/editar"
        app:backgroundTint="@color/blue"
        tools:layout_editor_absoluteX="607dp"
        tools:layout_editor_absoluteY="24dp" />

    <Button
        android:id="@+id/button10"
        android:layout_width="110dp"
        android:layout_height="45dp"
        android:layout_marginEnd="604dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rectangle"
        android:text="@string/compartir"
        app:backgroundTint="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>