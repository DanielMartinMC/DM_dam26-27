<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/text_equipo1"
        android:layout_width="130dp"
        android:layout_height="40dp"
        android:text="Equipo 1"


        android:textColor="@color/white"
        android:textSize="32sp"


        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.191" />

    <TextView
        android:id="@+id/text_equipo2"
        android:layout_width="130dp"
        android:layout_height="40dp"

        android:layout_marginEnd="140dp"
        android:layout_marginBottom="304dp"
        android:text="Equipo 2"

        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textX"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="X"
        android:textColor="@color/white"

        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="@id/text34"
        app:layout_constraintHorizontal_bias="0.504"

        app:layout_constraintStart_toStartOf="@id/text34"
        app:layout_constraintTop_toBottomOf="@id/text34" />

    <TextView
        android:id="@+id/text10"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"

        android:fontFamily="@font/clasic_bold"
        android:gravity="center"
        android:maxLines="1"
        android:text="10:00"

        android:textColor="@color/red"
        android:textSize="57sp"
        app:layout_constraintStart_toEndOf="@+id/play_button"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text34"
        android:layout_width="137dp"
        android:layout_height="104dp"

        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="452dp"

        android:fontFamily="@font/clasic_bold"
        android:gravity="center"
        android:maxLines="1"

        android:text="34"
        android:textColor="@color/green"
        android:textSize="84sp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.314"
        app:layout_constraintStart_toEndOf="@+id/button_2"
        />


    <TextView
        android:id="@+id/text18"
        android:layout_width="137dp"
        android:layout_height="104dp"

        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"

        android:fontFamily="@font/clasic_bold"
        android:gravity="center"
        android:maxLines="1"

        android:text="18"
        android:textColor="@color/green"
        android:textSize="84sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textX"
        app:layout_constraintVertical_bias="0.264" />

    <Button
        android:id="@+id/play_button"
        android:layout_width="71dp"
        android:layout_height="70dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/play_circle"

        app:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:importantForAccessibility="no"
        />


    <Button
        android:id="@+id/boton_uno"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="132dp"
        android:background="@drawable/circle_button"

        android:gravity="center"
        android:padding="0dp"
        android:text="+1"
        android:textColor="@color/black"
        android:textSize="18sp"

        app:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_2"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="188dp"
        android:background="@drawable/circle_button"

        android:gravity="center"
        android:padding="0dp"
        android:text="+2"
        android:textColor="@color/black"
        android:textSize="18sp"

        app:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_3"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="244dp"
